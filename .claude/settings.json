{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && bash \"$ROOT/.claude/hooks/update-models.sh\" || exit 0",
            "timeout": 1200,
            "statusMessage": "Refreshing SciKick LLM model tables…"
          }
        ]
      }
    ]
  }
}
